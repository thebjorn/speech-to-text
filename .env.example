# Copy this file to .env and fill in the value. The real .env is gitignored;
# this .env.example template is committed so the expected keys are documented.
#
# Hugging Face token for speaker diarization (see the README "Speaker labels"
# section). Needs only READ access, and you must accept the model terms at
# https://hf.co/pyannote/speaker-diarization-3.1 and
# https://hf.co/pyannote/segmentation-3.0 with the same account.
HF_TOKEN=

# Optional: path to a shared-build FFmpeg's bin directory (the folder holding
# ffmpeg.exe and avcodec-*.dll). Diarization decodes audio via torchcodec,
# which needs FFmpeg's DLLs; set this if FFmpeg is not already on your PATH.
# Example: FFMPEG_BIN=E:\lib\ffmpeg-8.1.1-full_build-shared\bin
FFMPEG_BIN=
